# Sao chép file này thành .env.local và điền giá trị thật.
# .env.local được gitignore — không bao giờ push lên GitHub.

# Supabase (bắt buộc)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Mật khẩu trang Admin (/admin) — đổi thành mật khẩu mạnh
NEXT_PUBLIC_ADMIN_PASSWORD=your-secure-admin-password

# OneSignal push notifications (tùy chọn)
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key
